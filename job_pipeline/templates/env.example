NOTION_TOKEN=secret_your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Your Claude API key.
ANTHROPIC_API_KEY=sk-ant-your_api_key

# Optional: keep keys for more than one Claude account. CLAUDE_ACCOUNT picks
# which one is used; --account on the command line overrides it for one run.
# CLAUDE_ACCOUNT=work
# ANTHROPIC_API_KEY_WORK=sk-ant-another_key

# Optional: which Claude model writes the resumes (default claude-sonnet-4-6).
# CLAUDE_MODEL=claude-sonnet-4-6
